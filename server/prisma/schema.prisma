// Prisma Schema for Pig Farm Management System
// This is the actual schema used by the backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Simple Animal model to start with
// You can expand this based on docs/database-schema.prisma
model Animal {
  id          String   @id @default(cuid())
  tagNo       String   @unique
  name        String?
  type        String   // 'sow' or 'boar'
  breed       String?
  gender      String?
  dob         DateTime?
  weight      Float?
  group       String?
  imageUrl    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([tagNo])
}

// Add more models as you develop:
// - Events
// - Breeding records
// - Litters
// - Feed records
// etc.
