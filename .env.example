# Pig Farm Management System - Environment Variables Template
# Copy this file to .env.local for local development
# NEVER commit .env.local to git!

# ==================== FRONTEND (Vercel/Next.js) ====================
# Supabase Configuration (for static site and Next.js)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ==================== BACKEND (Render/NestJS) ====================
# Database
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourapp.vercel.app

# Optional: Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Optional: File Storage (if not using Supabase Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ==================== PRODUCTION SETTINGS ====================
# For Render (Backend):
# - Set DATABASE_URL, JWT_SECRET, PORT, NODE_ENV=production, CORS_ORIGINS
#
# For Vercel (Frontend):
# - Set NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# - Set NEXT_PUBLIC_API_URL (your Render backend URL)
